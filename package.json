{
  "name": "siteboard",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "siteboard": "./cli/siteboard.js"
  },
  "files": [
    "cli/archive.js",
    "cli/cloudflare-api.js",
    "cli/cloudflare.js",
    "cli/command-runner.js",
    "cli/history-store.js",
    "cli/live-verify.js",
    "cli/server.js",
    "cli/siteboard.js",
    "cli/studio-operations.js",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web",
    "build:web": "tsc --noEmit && vite build",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:debug": "tauri build --debug --no-bundle",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:icon": "tauri icon public/icon-512.png",
    "lint": "eslint .",
    "test": "vitest run --exclude scripts/retire-web.test.mjs",
    "test:watch": "vitest --exclude scripts/retire-web.test.mjs",
    "preview": "vite preview",
    "studio": "node ./cli/siteboard.js studio",
    "prepare": "npm run build",
    "build:retired": "npm run build:web && node scripts/retire-web.mjs",
    "test:retirement": "node --test scripts/retire-web.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "fflate": "^0.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "wrangler": "^4.128.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
